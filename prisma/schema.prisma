// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 中文拼写词汇表
model ChineseSpellingItem {
  id          String   @id @default(uuid())
  english     String
  chinese     String
  category    String?
  tags        String?  // JSON string array
  difficulty  String?  // 'easy' | 'medium' | 'hard'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  favorites   ChineseSpellingFavorite[]
}

// 中文拼写收藏表
model ChineseSpellingFavorite {
  id             String   @id @default(uuid())
  itemId         String
  favoriteDate   String   // YYYY-MM-DD format
  createdAt      DateTime @default(now())
  item           ChineseSpellingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, favoriteDate])
}
